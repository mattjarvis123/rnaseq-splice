/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Example config: shared server or HPC cluster with Apptainer
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Copy this file, replace the paths and numbers, keep option A or B, then run (inside
    screen/tmux, or as a job):

        nextflow run mattjarvis123/rnaseq-splice -profile apptainer \
            -c hpc_apptainer.config -params-file params.yaml \
            -w /local/scratch/rnaseq_splice/work

    Launch from a folder on local disk: Nextflow keeps its run history in .nextflow/ there
    and needs reliable file locking, which network shares (SMB/CIFS) do not always give.
    The work folder (-w) needs symbolic links: use local disk, or a share mounted with
    symlink support (for CIFS, the mfsymlinks mount option). Inputs and --outdir can be on
    a network share. See docs/splice_usage.md, "Running on a cluster or shared storage".
----------------------------------------------------------------------------------------
*/

apptainer {
    // Keep container images on local disk between runs, so they are downloaded once
    cacheDir = '/path/to/local/apptainer_cache'
}

process {
    // Most that any single task may request
    resourceLimits = [cpus: 16, memory: 128.GB, time: 72.h]
}

// ---- Option A: one shared server, tasks run directly on it -----------------------------
executor {
    // Your share of the server: most that all running tasks may use together
    cpus   = 48
    memory = 400.GB
}

// ---- Option B: SLURM cluster (delete option A and uncomment) ----------------------------
// process {
//     executor       = 'slurm'
//     queue          = 'normal'
//     clusterOptions = '--account=my_account'
// }
// executor {
//     queueSize = 50   // most jobs in the queue at once
// }
