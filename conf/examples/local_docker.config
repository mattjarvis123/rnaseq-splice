/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Example config: laptop or workstation with Docker
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Copy this file, set the numbers for your machine, then run:

        nextflow run mattjarvis123/rnaseq-splice -profile docker \
            -c local_docker.config -params-file params.yaml

    Docker Desktop has its own limits (Settings > Resources): give it at least the memory
    and CPUs set here. A human STAR index needs about 32-38 GB of memory.
----------------------------------------------------------------------------------------
*/

process {
    // Most that any single task may request (leave some memory for the operating system)
    resourceLimits = [cpus: 12, memory: 46.GB, time: 48.h]
}

executor {
    // Most that all running tasks may use together
    cpus   = 12
    memory = 46.GB
}
