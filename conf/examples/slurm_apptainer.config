/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Example config: SLURM cluster with Apptainer
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Every pipeline task is submitted as its own SLURM job. Copy this file, replace the
    partition, account, paths and limits for your cluster, then start the pipeline with
    submit_slurm.sh (or from a login node inside screen/tmux):

        nextflow run mattjarvis123/rnaseq-splice -profile apptainer \
            -c slurm_apptainer.config -params-file params.yaml \
            -w /shared/scratch/$USER/rnaseq_splice/work

    The work folder and the container cache must be on a filesystem that every compute
    node can see (cluster scratch, Lustre, GPFS or NFS).
----------------------------------------------------------------------------------------
*/

process {
    executor       = 'slurm'
    queue          = 'normal'                   // SLURM partition
    clusterOptions = '--account=my_account'     // remove if your cluster has no accounts

    // Most that any single job may request: keep within the partition's limits
    resourceLimits = [cpus: 32, memory: 256.GB, time: 72.h]
}

executor {
    queueSize       = 50          // most jobs queued or running at once
    submitRateLimit = '20/1min'   // be gentle with the scheduler
    pollInterval    = '30 sec'
}

apptainer {
    // Shared folder for container images, downloaded once by the head job
    cacheDir = '/shared/containers/apptainer_cache'
}
