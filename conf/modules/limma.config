/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    limma/voom differential expression
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Options are passed to the nf-core module R templates as '--key value' pairs.
    See modules/nf-core/{custom/matrixfilter,limma/differential}/templates/*.R for all
    available keys.
----------------------------------------------------------------------------------------
*/

process {
    // Keep genes with >= limma_min_count counts in at least as many samples as the
    // smallest condition group
    withName: '.*:DIFFERENTIAL_LIMMA:CUSTOM_MATRIXFILTER' {
        ext.prefix = 'gene_counts'
        ext.args   = { [
            "--sample_id_col sample",
            "--minimum_abundance ${params.limma_min_count}",
            "--grouping_variable condition",
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/limma" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:DIFFERENTIAL_LIMMA:LIMMA_DIFFERENTIAL' {
        ext.args   = { [
            "--sample_id_col sample",
            "--probe_id_col gene_id",
            "--use_voom true",
            "--robust ${params.limma_robust}",
            "--adjust.method BH",
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/limma/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
