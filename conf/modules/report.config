/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    rnaseq-splice results report (final step)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Options are passed to assets/report/render_report.R as '--key value' pairs.
    Results: <outdir>/report/<report_name>.html and <report_name>_tables/
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*:RNASEQ_SPLICE_REPORT' {
        ext.prefix = { params.report_name }
        ext.args   = { [
            "--title '${params.report_title.toString().replace("'", "'\\''")}'",
            params.report_project ? "--project '${params.report_project.toString().replace("'", "'\\''")}'" : '',
            "--results_label '${params.outdir.toString().replaceAll('/+$', '').tokenize('/').last()}'",  // folder name only, not the full path
            "--fdr_de ${params.report_de_fdr}",
            "--lfc_de ${params.report_de_lfc}",
            "--fdr_splicing ${params.report_splicing_fdr}",
            "--dpsi_splicing ${params.report_splicing_dpsi}",
            "--fdr_gsea ${params.gsea_fdr}",
            "--kegg_maps ${params.report_kegg_maps}",
            params.report_kegg_cache ? "--kegg_cache '${params.report_kegg_cache}'" : '--kegg_cache kegg_cache',
            "--table_max_rows ${params.report_table_max_rows}",
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
