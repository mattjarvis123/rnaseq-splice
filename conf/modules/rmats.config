/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    rMATS differential splicing
    Ported from nf-core/rnasplice 2.0.0 (conf/modules.config)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    `--novelSS` and its `--mil`/`--mel` limits shape the splicing graph in both steps,
    so they are given to both. The library options only matter to the prep step and
    the statistical model only to the post step.
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*:RMATS:RMATS_PREP' {
        ext.args = { [
            '--variable-read-length',
            '--allow-clipping',
            "-t ${meta.single_end ? 'single' : 'paired'}",
            "--libType ${meta.strandedness == 'forward' ? 'fr-secondstrand' : meta.strandedness == 'reverse' ? 'fr-firststrand' : 'fr-unstranded'}",
            params.rmats_novel_splice_site.toString().toBoolean() ? "--novelSS --mil ${params.rmats_min_intron_len} --mel ${params.rmats_max_exon_len}" : '',
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats/prep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:RMATS:RMATS_POST' {
        ext.args = { [
            "--cstat ${params.rmats_splice_diff_cutoff}",
            params.rmats_paired_stats.toString().toBoolean() ? '--paired-stats' : '',
            params.rmats_novel_splice_site.toString().toBoolean() ? "--novelSS --mil ${params.rmats_min_intron_len} --mel ${params.rmats_max_exon_len}" : '',
        ].join(' ').trim() }
        ext.prefix = { params.rmats_paired_stats.toString().toBoolean() ? "${meta.id}_paired" : "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Read-coverage filter (bin/rmats_filter.R); filtered tables go to rmats/<contrast>/filtered/
    withName: '.*:RMATS:RMATS_FILTER' {
        ext.args = { "--min_reads ${params.rmats_min_reads}" }
        ext.prefix = { params.rmats_paired_stats.toString().toBoolean() ? "${meta.id}_paired" : "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:RMATS:CREATEBAMLIST' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats/bamlist" },
            mode: params.publish_dir_mode,
            pattern: "*.txt"
        ]
    }
}
