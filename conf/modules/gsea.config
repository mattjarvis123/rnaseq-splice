/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Gene set enrichment (fgsea) of the limma/voom and rMATS results
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Options are passed to bin/fgsea_de.R and bin/fgsea_splicing.R as '--key value' pairs.
    Results: <outdir>/<aligner>/gsea/<contrast>/
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*:GSEA:FGSEA_DE' {
        ext.args   = { [
            "--rank_by ${params.gsea_rank_by}",
            "--min_size ${params.gsea_min_size}",
            "--max_size ${params.gsea_max_size}",
            "--fdr ${params.gsea_fdr}",
            "--seed 42",
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/gsea/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:GSEA:FGSEA_SPLICING' {
        ext.args   = { [
            "--event_fdr ${params.gsea_splicing_fdr}",
            "--event_dpsi ${params.gsea_splicing_dpsi}",
            "--min_size ${params.gsea_min_size}",
            "--max_size ${params.gsea_max_size}",
            "--fdr ${params.gsea_fdr}",
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/gsea/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
