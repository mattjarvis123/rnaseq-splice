/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test with rMATS differential splicing and limma/voom enabled
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Builds on the 'test' profile. Use as follows:
        nextflow run . -profile test_rmats,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Test rMATS profile'
    config_profile_description = 'Minimal test dataset with rMATS differential splicing and limma/voom'

    input     = "${projectDir}/assets/test/samplesheet_rmats.csv"
    contrasts = "${projectDir}/assets/test/contrasts_rmats.csv"
    rmats     = true
    limma     = true
}
